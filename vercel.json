{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "256-team-wc.vercel.app"
        }
      ],
      "destination": "https://www.256teams.com/:path*",
      "permanent": true
    }
  ]
}
